# =====================================================================
#  Voice pipeline: Deepgram STT  ->  LLM (OpenRouter/Cerebras)  ->  Sarvam Bulbul TTS (WebSocket)
#  (chosen for low latency; only TTS stays on Sarvam)
# =====================================================================

# ---- Deepgram (speech-to-text) ----
# Get a key at https://console.deepgram.com
DEEPGRAM_API_KEY=
# nova-3 supports language=multi (Hindi/English/Gujarati); nova-2 does NOT.
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
# Turn ends after this many ms of silence (lower = snappier, higher = fewer false turns)
DEEPGRAM_ENDPOINTING_MS=450
DEEPGRAM_UTTERANCE_END_MS=1500

# STT quality gates — reject low-confidence / garbage transcripts (no word lists)
STT_MIN_CONFIDENCE=0.62
STT_BARGE_IN_MIN_CONFIDENCE=0.72
STT_BARGE_IN_MIN_WORDS=2
STT_BARGE_IN_HIGH_CONF=0.85
STT_MIN_LETTER_RATIO=0.40

# Ignore barge-in for this many seconds after agent audio starts (echo protection)
BARGE_IN_GRACE_S=1.25

# ---- LLM (OpenRouter -> Groq preferred for lowest TTFT) ----
# Get an OpenRouter key at https://openrouter.ai/keys
# gpt-oss-120b via Groq is the fastest route we measured; Cerebras is fallback.
LLM_CHAT_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# Alias also accepted:
# OPENROUTER_API_KEY=

# Legacy Groq fallback (used when LLM_API_KEY / OPENROUTER_API_KEY is empty)
# GROQ_API_KEY=
# GROQ_LLM_MODEL=openai/gpt-oss-20b
# GROQ_CHAT_URL=https://api.groq.com/openai/v1/chat/completions

# ---- Sarvam (text-to-speech, WebSocket streaming) ----
# Get a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=rahul
SARVAM_TTS_SAMPLE_RATE=24000

# Seconds to wait for a continuation fragment before answering (merges fragments)
TURN_DEBOUNCE=0.15

# ---- Twilio (phone calls) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+19785715824
PUBLIC_URL=

# ---- Admin dashboard ----
# Key required to open /admin and call /api/admin/* (X-Admin-Key header / ?key=)
ANALYTICS_SECRET=kataria2026

# ---- Call log + cost storage ----
# JSON call records are written to DATA_DIR/calls/<id>.json.
# NOTE: Render wipes the local filesystem on every deploy. For durable history,
# attach a Render Persistent Disk and set DATA_DIR to a path on it, e.g. /var/data
DATA_DIR=

# ---- Cost rates ----
# Deepgram STT (USD per minute of audio) — nova-2/3 pay-as-you-go ~ $0.0077/min
RATE_DEEPGRAM_PER_MIN=0.0077
# LLM via OpenRouter (USD per 1M tokens) — Groq route for openai/gpt-oss-120b
RATE_LLM_IN_PER_1M=0.15
RATE_LLM_OUT_PER_1M=0.60
LLM_PROVIDER_LABEL=openrouter/groq
# Legacy aliases (still accepted by pricing.py)
# RATE_GROQ_IN_PER_1M=0.15
# RATE_GROQ_OUT_PER_1M=0.60
# Sarvam Bulbul v3 TTS (INR per 10,000 characters)
RATE_SARVAM_TTS_PER_10K=30.0
# INR -> USD conversion used to price Sarvam TTS into the USD total
USD_INR=88.0
# Twilio fallback (USD per minute) until real billed Call.price is fetched
RATE_TWILIO_PER_MIN=0.014
