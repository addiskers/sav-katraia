# =====================================================================
#  Voice pipeline: Deepgram STT  ->  Groq LLM  ->  Sarvam Bulbul TTS
#  (chosen for low latency; only TTS stays on Sarvam)
# =====================================================================

# ---- Deepgram (speech-to-text) ----
# Get a key at https://console.deepgram.com
DEEPGRAM_API_KEY=
# nova-3 supports language=multi (Hindi/English/Gujarati); nova-2 does NOT.
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
# Turn ends after this many ms of silence (higher = fewer half-sentence cuts)
DEEPGRAM_ENDPOINTING_MS=800
DEEPGRAM_UTTERANCE_END_MS=1000

# ---- Groq (LLM / the agent's brain) ----
# Get a key at https://console.groq.com
# gpt-oss-120b is fast on Groq with strong tool-calling + multilingual.
# (Llama-3.3-70B also works if your account has access.)
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b

# ---- Sarvam (text-to-speech only) ----
# Get a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=rahul
SARVAM_TTS_SAMPLE_RATE=24000

# Seconds to wait for a continuation fragment before answering (merges fragments)
TURN_DEBOUNCE=0.6

# ---- Twilio (phone calls) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+19785715824
PUBLIC_URL=

# ---- Admin dashboard ----
# Key required to open /admin and call /api/admin/* (X-Admin-Key header / ?key=)
ANALYTICS_SECRET=kataria2026

# ---- Call log + cost storage ----
# JSON call records are written to DATA_DIR/calls/<id>.json.
# NOTE: Render wipes the local filesystem on every deploy. For durable history,
# attach a Render Persistent Disk and set DATA_DIR to a path on it, e.g. /var/data
DATA_DIR=

# ---- Cost rates ----
# Deepgram STT (USD per minute of audio) — nova-2/3 pay-as-you-go ~ $0.0077/min
RATE_DEEPGRAM_PER_MIN=0.0077
# Groq gpt-oss-120b (USD per 1M tokens)
RATE_GROQ_IN_PER_1M=0.15
RATE_GROQ_OUT_PER_1M=0.75
# Sarvam Bulbul v3 TTS (INR per 10,000 characters)
RATE_SARVAM_TTS_PER_10K=30.0
# INR -> USD conversion used to price Sarvam TTS into the USD total
USD_INR=88.0
# Twilio fallback (USD per minute) until real billed Call.price is fetched
RATE_TWILIO_PER_MIN=0.014
